# Copy this file to .env and fill in real values before running.

# SQLite file lives next to the app by default.
DATABASE_URL=sqlite:///./crisis.db

# Admin bearer token required for the /api/admin/* review-queue endpoints.
# Generate a long random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# OpenRouter (https://openrouter.ai/keys) powers: source-update classification,
# tip moderation triage, and feed summarization. If left blank, the app still
# runs — ingestion/moderation endpoints fall back to a manual "needs review"
# state with no AI classification.
OPENROUTER_API_KEY=
# "openrouter/free" auto-routes across whichever free-tier model/provider is
# currently available, which is more resilient than pinning one provider's
# free model (those get individually rate-limited under shared load -- we
# saw this happen live with google/gemma). Free models get added/retired
# over time -- check https://openrouter.ai/models?max_price=0 for options.
OPENROUTER_MODEL=openrouter/free

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Where uploaded tip images are stored on disk. NOTE: this must be a
# persistent disk-backed host (e.g. Render/Railway/Fly), not a serverless
# platform like Vercel, whose filesystem is ephemeral per-request.
UPLOAD_DIR=./uploads
