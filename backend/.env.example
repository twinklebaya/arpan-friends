# Copy this file to .env and fill in real values before running.

# Database. Production uses the Supabase Postgres resource "arpan-friends"
# (provisioned via Vercel Storage / Supabase integration). Get the connection
# string from Vercel -> Storage -> arpan-friends -> ".env.local" tab, or from
# Supabase -> Project Settings -> Database -> Connection string.
#
# Use the POOLED connection (port 6543, via the pooler hostname) here, NOT
# the direct one (port 5432) -- this backend runs as Vercel serverless
# functions, where each invocation is a short-lived process that can't share
# a persistent connection pool. Supabase's own PgBouncer pooler handles that
# instead (paired with NullPool in database.py). Drop any "pgbouncer=true"
# query param some Supabase-generated URLs include -- that's a Prisma-only
# hint and psycopg2 rejects it as an invalid DSN option. It looks like:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
#
# Leave this as the sqlite default for local development if you'd rather not
# hit the shared production database while iterating.
DATABASE_URL=sqlite:///./crisis.db

# Admin bearer token required for the /api/admin/* review-queue endpoints.
# Generate a long random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# OpenRouter (https://openrouter.ai/keys) powers: source-update classification,
# tip moderation triage, and feed summarization. If left blank, the app still
# runs — ingestion/moderation endpoints fall back to a manual "needs review"
# state with no AI classification.
OPENROUTER_API_KEY=
# "openrouter/free" auto-routes across whichever free-tier model/provider is
# currently available, which is more resilient than pinning one provider's
# free model (those get individually rate-limited under shared load -- we
# saw this happen live with google/gemma). Free models get added/retired
# over time -- check https://openrouter.ai/models?max_price=0 for options.
OPENROUTER_MODEL=openrouter/free

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,https://arpan-friends.vercel.app

# Supabase Storage, used for tip-submission images (public "tip-uploads"
# bucket). Required for the /api/tips upload flow -- get both from Supabase
# -> Project Settings -> API. The service role key bypasses RLS for
# server-side uploads; never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
